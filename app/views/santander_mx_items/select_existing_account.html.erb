<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title", account_name: @account.name)) %>

  <% dialog.with_body do %>
    <div class="space-y-4">
      <% if @available_accounts.empty? %>
        <p class="text-sm text-secondary"><%= t(".no_accounts") %></p>

        <div class="flex gap-2 justify-end pt-4">
          <%= render DS::Button.new(
            text: t(".sync_now"),
            icon: "refresh-cw",
            variant: :primary,
            href: sync_santander_mx_item_path(@santander_mx_item),
            method: :post,
            disabled: @santander_mx_item.syncing?,
            data: { turbo_frame: "_top" }
          ) %>
          <%= render DS::Link.new(
            text: t(".cancel"),
            href: @return_to || accounts_path,
            variant: :secondary,
            data: { turbo_frame: "_top", action: "DS--dialog#close" }
          ) %>
        </div>
      <% else %>
        <p class="text-sm text-secondary"><%= t(".description") %></p>

        <%= form_with url: link_existing_account_santander_mx_items_path,
                      method: :post,
                      data: { turbo_frame: "_top" },
                      class: "space-y-4" do %>
          <%= hidden_field_tag :santander_mx_item_id, @santander_mx_item.id %>
          <%= hidden_field_tag :account_id, @account.id %>
          <%= hidden_field_tag :return_to, @return_to %>

          <div class="space-y-2">
            <% @available_accounts.each do |product| %>
              <label class="flex items-start gap-3 p-3 border border-primary rounded-lg hover:bg-subtle cursor-pointer transition-colors">
                <%= radio_button_tag :santander_mx_account_id, product.id, false, class: "mt-1" %>
                <div class="flex-1">
                  <div class="font-medium text-sm text-primary"><%= product.name %></div>
                  <div class="text-xs text-secondary mt-1">
                    <%= [ product.last4.present? ? t(".last4", last4: product.last4) : nil, product.currency ].compact_blank.join(" · ") %>
                  </div>
                </div>
              </label>
            <% end %>
          </div>

          <div class="flex gap-2 justify-end pt-4">
            <%= render DS::Link.new(
              text: t(".cancel"),
              href: @return_to || accounts_path,
              variant: :secondary,
              data: { turbo_frame: "_top", action: "DS--dialog#close" }
            ) %>
            <%= render DS::Button.new(text: t(".link_account"), type: "submit") %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
