<%# locals: (santander_mx_item:, visible_accounts:) %>

<%= tag.div id: dom_id(santander_mx_item) do %>
  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center justify-between gap-2 w-full">
        <div class="flex items-center gap-2">
          <%= icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>

          <%= render ProviderLogo.new(provider_key: :santander_mx) %>

          <div class="pl-1 text-sm">
            <div class="flex items-center gap-2">
              <%= tag.p santander_mx_item.name, class: "font-medium text-primary" %>
              <% if santander_mx_item.scheduled_for_deletion? %>
                <p class="text-destructive text-sm animate-pulse"><%= t(".deletion_in_progress") %></p>
              <% end %>
            </div>

            <% if santander_mx_item.syncing? %>
              <div class="text-secondary flex items-center gap-1">
                <%= icon "loader", size: "sm", class: "animate-spin" %>
                <%= tag.span t(".syncing") %>
              </div>
            <% elsif santander_mx_item.requires_update? %>
              <div class="flex items-center gap-1">
                <%= icon "alert-triangle", size: "sm", color: "warning" %>
                <%= tag.span t(".requires_update"), class: "text-warning" %>
              </div>
            <% elsif santander_mx_item.sync_error.present? %>
              <div class="text-secondary flex items-center gap-1">
                <%= render DS::Tooltip.new(text: santander_mx_item.sync_error, icon: "alert-circle", size: "sm", color: "destructive", as: :span) %>
                <%= tag.span t(".error"), class: "text-destructive" %>
              </div>
            <% else %>
              <p class="text-secondary">
                <% if santander_mx_item.last_synced_at %>
                  <%= t(".status", timestamp: time_ago_in_words(santander_mx_item.last_synced_at)) %>
                <% else %>
                  <%= t(".status_never") %>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>

        <% if Current.user&.admin? %>
          <div class="flex items-center gap-2">
            <%= render DS::Menu.new do |menu| %>
              <% menu.with_item(
                variant: "button",
                text: t(".sync"),
                icon: "refresh-cw",
                href: sync_santander_mx_item_path(santander_mx_item),
                method: :post
              ) unless santander_mx_item.syncing? || santander_mx_item.scheduled_for_deletion? %>
              <% sync_schedule_menu_item(menu, santander_mx_item) %>
              <% menu.with_item(
                variant: "button",
                text: t(".delete"),
                icon: "trash-2",
                href: santander_mx_item_path(santander_mx_item),
                method: :delete,
                confirm: CustomConfirm.for_resource_deletion(santander_mx_item.name, high_severity: true)
              ) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% unless santander_mx_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if visible_accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: visible_accounts %>
        <% end %>

        <%# The accounts index preloads one stats row per item; a standalone render (the %>
        <%# sync-complete broadcast) has to look it up itself. %>
        <% stats = if defined?(@santander_mx_sync_stats_map) && @santander_mx_sync_stats_map
             @santander_mx_sync_stats_map[santander_mx_item.id] || {}
           else
             santander_mx_item.latest_sync_record&.sync_stats || {}
           end %>
        <%= render ProviderSyncSummary.new(stats: stats, provider_item: santander_mx_item, show_account_details: visible_accounts.size == santander_mx_item.accounts.size) %>

        <% if santander_mx_item.requires_update? %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t(".requires_update_title") %></p>
            <p class="text-secondary text-sm"><%= t(".requires_update_description") %></p>
            <%= render DS::Link.new(
              text: t(".update_token"),
              icon: "key-round",
              variant: "primary",
              href: settings_providers_path,
              frame: "_top"
            ) %>
          </div>
        <% end %>

        <% if Current.user&.admin? && santander_mx_item.unlinked_accounts_count > 0 %>
          <div class="p-4 space-y-2">
            <p class="text-primary font-medium text-sm"><%= t(".waiting_title") %></p>
            <p class="text-secondary text-sm"><%= t(".waiting_description") %></p>
            <ul class="space-y-1 text-sm text-secondary">
              <% santander_mx_item.santander_mx_accounts.unlinked.order(:name).each do |santander_mx_account| %>
                <li>
                  <% if santander_mx_account.last4.present? %>
                    <%= t(".waiting_to_link", name: santander_mx_account.name, last4: santander_mx_account.last4) %>
                  <% else %>
                    <%= t(".waiting_to_link_no_last4", name: santander_mx_account.name) %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% elsif santander_mx_item.total_accounts_count.zero? && !santander_mx_item.requires_update? %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t(".no_accounts_title") %></p>
            <p class="text-secondary text-sm"><%= t(".no_accounts_description") %></p>
            <%= render DS::Button.new(
              text: t(".sync_now"),
              icon: "refresh-cw",
              variant: "primary",
              href: sync_santander_mx_item_path(santander_mx_item),
              method: :post,
              disabled: santander_mx_item.syncing?
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
