<div id="santander-mx-providers-panel" class="space-y-4">
  <% active_items = local_assigns[:santander_mx_items] || @santander_mx_items || Current.family.santander_mx_items.active.ordered %>

  <%= render "settings/providers/setup_steps",
             steps: [
               t("settings.providers.santander_mx_panel.step_1"),
               t("settings.providers.santander_mx_panel.step_2"),
               t("settings.providers.santander_mx_panel.step_3")
             ] %>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <%= render DS::Alert.new(message: error_msg, variant: :error) %>
  <% end %>

  <% if active_items.any? %>
    <div class="space-y-3">
      <% active_items.each do |item| %>
        <%= render DS::Disclosure.new(variant: :card) do |disclosure| %>
          <% disclosure.with_summary_content do %>
            <div class="flex items-center justify-between gap-2 w-full">
              <div class="flex items-center gap-3">
                <%= render ProviderLogo.new(provider_key: :santander_mx) %>
                <div>
                  <p class="font-medium text-primary"><%= item.name %></p>
                  <p class="text-xs text-secondary">
                    <% if item.syncing? %>
                      <%= t("santander_mx_items.provider_panel.syncing") %>
                    <% elsif item.requires_update? %>
                      <%= t("santander_mx_items.provider_panel.requires_update") %>
                    <% elsif item.last_synced_at %>
                      <%= t("santander_mx_items.provider_panel.last_synced", timestamp: time_ago_in_words(item.last_synced_at)) %>
                    <% else %>
                      <%= t("santander_mx_items.provider_panel.never_synced") %>
                    <% end %>
                  </p>
                </div>
              </div>
            </div>
          <% end %>

          <div class="mt-4 space-y-4">
            <% if item.requires_update? %>
              <%= render DS::Alert.new(message: t("santander_mx_items.provider_panel.requires_update_notice"), variant: :warning) %>
            <% end %>

            <p class="text-sm text-secondary">
              <%= t("santander_mx_items.provider_panel.accounts_summary", linked: item.linked_accounts_count, total: item.total_accounts_count) %>
            </p>

            <div class="flex items-center gap-2">
              <%= render DS::Button.new(
                text: t("santander_mx_items.provider_panel.sync"),
                icon: "refresh-cw",
                variant: :outline,
                size: :sm,
                href: sync_santander_mx_item_path(item, source: "panel"),
                method: :post,
                disabled: item.syncing?
              ) %>
              <%= render DS::Button.new(
                text: t("santander_mx_items.provider_panel.disconnect"),
                icon: "trash-2",
                variant: :outline_destructive,
                size: :sm,
                href: santander_mx_item_path(item),
                method: :delete,
                data: { turbo_confirm: t("santander_mx_items.provider_panel.disconnect_confirm", name: item.name) }
              ) %>
            </div>

            <%= styled_form_with model: item,
                                 url: santander_mx_item_path(item),
                                 scope: :santander_mx_item,
                                 method: :patch,
                                 data: { turbo: true },
                                 class: "space-y-3" do |form| %>
              <%= form.text_field :name,
                                  label: t("santander_mx_items.provider_panel.connection_name_label"),
                                  placeholder: t("santander_mx_items.provider_panel.connection_name_placeholder") %>

              <%= form.url_field :base_url,
                                 label: t("santander_mx_items.provider_panel.base_url_label"),
                                 placeholder: t("santander_mx_items.provider_panel.base_url_placeholder") %>

              <%= form.password_field :api_token,
                                      label: t("santander_mx_items.provider_panel.api_token_label"),
                                      placeholder: t("santander_mx_items.provider_panel.keep_token_placeholder"),
                                      value: nil %>

              <%= form.date_field :sync_start_date,
                                  label: t("santander_mx_items.provider_panel.sync_start_date_label"),
                                  value: item.sync_start_date&.to_date,
                                  max: Date.current %>

              <div class="flex justify-end">
                <%= render DS::Button.new(
                  text: t("santander_mx_items.provider_panel.update_connection"),
                  type: "submit"
                ) %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# One connection per family: SantanderMxItemsController#create refuses a second. %>
  <% if active_items.none? %>
    <% santander_mx_item = Current.family.santander_mx_items.build(name: t("santander_mx_items.provider_panel.default_connection_name")) %>
    <%= styled_form_with model: santander_mx_item,
                         url: santander_mx_items_path,
                         scope: :santander_mx_item,
                         method: :post,
                         data: { turbo: true },
                         class: "space-y-3" do |form| %>
      <%= form.text_field :name,
                          label: t("santander_mx_items.provider_panel.connection_name_label"),
                          placeholder: t("santander_mx_items.provider_panel.connection_name_placeholder") %>

      <%= form.url_field :base_url,
                         label: t("santander_mx_items.provider_panel.base_url_label"),
                         placeholder: t("santander_mx_items.provider_panel.base_url_placeholder"),
                         value: nil %>

      <%= form.password_field :api_token,
                              label: t("santander_mx_items.provider_panel.api_token_label"),
                              placeholder: t("santander_mx_items.provider_panel.api_token_placeholder"),
                              value: nil %>

      <%= form.date_field :sync_start_date,
                          label: t("santander_mx_items.provider_panel.sync_start_date_label"),
                          value: Date.current - 90,
                          max: Date.current %>

      <p class="text-xs text-secondary"><%= t("santander_mx_items.provider_panel.sync_start_date_hint") %></p>

      <div class="flex justify-end">
        <%= render DS::Button.new(
          text: t("santander_mx_items.provider_panel.add_connection"),
          type: "submit"
        ) %>
      </div>
    <% end %>
  <% end %>
</div>
